# Run python scripts/bootstrap_env.py to generate a local .env.
POSTGRES_USER=researchos
POSTGRES_DB=researchos
POSTGRES_PASSWORD=replace-with-a-generated-password
RESEARCHOS_ENVIRONMENT=development
RESEARCHOS_DATABASE_URL=postgresql+psycopg://researchos:replace-with-a-generated-password@postgres:5432/researchos
RESEARCHOS_REDIS_URL=redis://redis:6379/0
RESEARCHOS_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
RESEARCHOS_PUBLIC_ORIGIN=http://localhost:3000
RESEARCHOS_SESSION_LIFETIME_HOURS=12
RESEARCHOS_MAX_UPLOAD_BYTES=26214400
# Container default; host runs may override this with a private absolute path.
RESEARCHOS_STORAGE_ROOT=/app/storage
